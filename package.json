{
  "name": "manhunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-Life Manhunt als Web-App für Freunde",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "ALLOW_SIM=1 node --env-file-if-exists=.env --watch server/index.js",
    "test": "node test/smoke.js && node test/archive.js && node test/geocode.js && node test/share.js",
    "simulate": "node test/simulation.js",
    "load": "node test/load.js",
    "check-live": "node scripts/check-live.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
